# Copy to .env. Without these two, the site still runs, showing sample prices only.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=

# bing (default) links straight to shops. google works, but Google throttles its redirect
# links, so most shop pages never get opened.
LIVE_SEARCH_ENGINE=bing

# How long results are saved. Longer is faster and cheaper; each result shows when it was checked.
LIVE_SEARCH_CACHE_MINUTES=180

# Comma-separated searches to keep saved in the background, so they load instantly. Each one is
# paid again at every refresh, about 9 times a day with the 180 minutes above. A search is 2
# paid requests on Bing, so 8 searches cost about 144 requests a day. Leave empty to turn this off.
LIVE_SEARCH_WARM=

# Paid requests allowed per day (UTC) before live search pauses, so 300 is about 150 new Bing
# searches. Saved results still work.
LIVE_SEARCH_DAILY_LIMIT=300

# The price list behind instant search, built by `npm run crawl` from shops' sitemaps. Set this to
# have the server rebuild it on a schedule, in hours; 24 keeps prices at most a day old. A full
# crawl reads about 18,000 pages, one a second per shop, and takes several hours. Leave empty to
# run `npm run crawl` yourself instead.
PRICE_INDEX_REFRESH_HOURS=

# Where the price list is saved. On a host whose disk is wiped on deploy, point this at a
# persistent disk, or every deploy starts with an empty list.
PRICE_INDEX_FILE=

# Pull the price list the nightly crawl publishes, on start and every PRICE_INDEX_PULL_HOURS, so a
# host that is not redeployed still gets fresh prices. For this repository:
# https://raw.githubusercontent.com/roybipro/daamkhoj-price-comparison/main/data/price-index.json
PRICE_INDEX_URL=
PRICE_INDEX_PULL_HOURS=6
