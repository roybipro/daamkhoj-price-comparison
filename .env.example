# Copy to .env. Without these two, the site still runs, showing sample prices only.
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=

# bing (default) links straight to shops. google works, but Google throttles its redirect
# links, so most shop pages never get opened.
LIVE_SEARCH_ENGINE=bing

# How long results are saved. Longer is faster and cheaper; each result shows when it was checked.
LIVE_SEARCH_CACHE_MINUTES=180

# Comma-separated searches to keep saved in the background, so they load instantly. Each one is
# paid again at every refresh, about 9 times a day with the 180 minutes above, so 8 searches
# cost about 72 requests a day. Leave empty to turn this off.
LIVE_SEARCH_WARM=

# Paid searches allowed per day (UTC) before live search pauses. Saved results still work.
LIVE_SEARCH_DAILY_LIMIT=300
