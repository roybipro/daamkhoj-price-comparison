# Build output — regenerate with `npm run build`
dist/

# Dependencies
node_modules/

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local environment and secrets
.env
.env.*
!.env.example
*.key
*.pem

# Logs
*.log
npm-debug.log*

# Local agent config (holds API tokens)
.codex/

# The crawled price list — rebuild with `npm run crawl`. A snapshot is committed so a fresh
# deploy (whose disk starts empty) answers instant searches at once.
data/*
!data/price-index.json
